digraph G {graph[rankdir=TB,bgcolor=white,nodesep=.35,ranksep=.3];node[shape=box,fontname="Arial",fontsize=11,style=filled,fillcolor="#F7F8FA"];edge[fontname="Arial",fontsize=10];a[label="1  Пациент → Интерфейс\nВыбрать врача и слот, подтвердить"];b[label="2  Интерфейс → Авторизация\nПроверить роль и владельца"];c[label="3  Интерфейс → Модуль записи\ncreateAppointment(patientId, slotId, operationId)"];d[label="4  Модуль записи → БД\nBEGIN и проверка свободного слота"];e[shape=diamond,label="Слот свободен?"];f[label="5а  БД\nINSERT Appointment и занять Slot\nCOMMIT"];g[label="5б  БД → Модуль записи\nROLLBACK и конфликт"];i[label="6а  Модуль записи → Уведомления\nПоставить подтверждение в очередь"];j[label="7а  Модуль записи → Интерфейс → Пациент\nID записи и «Вы записаны»"];k[label="6б  Модуль записи → Интерфейс → Пациент\n«Слот уже занят, выберите другое время»"];a->b->c->d->e;e->f[label="да"];e->g[label="нет"];f->i->j;g->k;}