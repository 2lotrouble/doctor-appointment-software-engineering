digraph G {graph[rankdir=LR,bgcolor=white,nodesep=.5,ranksep=.6];node[shape=record,fontname="Arial",fontsize=12,style=filled,fillcolor="#F7F8FA"];edge[fontname="Arial",fontsize=10];N[label="{Notification|id: int\lappointmentId: int\ltype: NotificationType\lstatus: NotificationStatus\lscheduledAt: DateTime\lsentAt: DateTime?\lattemptCount: int\lmessage: string\l|send()\lreschedule()\lcancel()\l}"];S[label="{NotificationStatus «enumeration»|PENDING\lSENT\lFAILED\lCANCELLED\l}"];T[label="{NotificationType «enumeration»|CONFIRMATION\lREMINDER\lCANCELLATION\l}"];A[label="{AppointmentStatus «enumeration»|CONFIRMED\lCOMPLETED\lCANCELLED\lNO_SHOW\l}"];N->S[style=dashed,label="status"];N->T[style=dashed,label="type"]; }