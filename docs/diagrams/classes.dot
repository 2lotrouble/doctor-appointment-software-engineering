digraph G {graph[rankdir=TB,bgcolor=white,nodesep=.3,ranksep=.65];node[shape=record,fontname="Arial",fontsize=11,style=filled,fillcolor="#F7F8FA"];edge[fontname="Arial",fontsize=10];User[label="{User «abstract»|id: int\lemail: string\lpasswordHash: string\lrole: Role\l|login()\llogout()\l}"];Patient[label="{Patient|fullName: string\lphone: string\l|createAppointment()\lcancelAppointment()\lrescheduleAppointment()\lviewHistory()\l}"];Doctor[label="{Doctor|specialtyId: int\l|viewSchedule()\lmarkAppointment()\l}"];Administrator[label="{Administrator||manageSchedule()\lcreateAppointment()\lcancelAppointment()\lgetStatistics(period)\l}"];Specialty[label="{Specialty|id: int\lname: string\l}"];Slot[label="{Slot|id: int\ldoctorId: int\lstartsAt: DateTime\lduration: int\l|isAvailable()\l}"];Appointment[label="{Appointment|id: int\lpatientId: int\ldoctorId: int\lslotId: int\lstatus: AppointmentStatus\lcancellationReason: string?\l|create()\lcancel()\lreschedule()\l}"];Notification[label="{Notification|appointmentId: int\ltype: NotificationType\lstatus: NotificationStatus\l|send()\l}"];User->Patient[dir=back,arrowtail=empty];User->Doctor[dir=back,arrowtail=empty];User->Administrator[dir=back,arrowtail=empty];{rank=same;Patient;Doctor;Administrator;}{rank=same;User;Specialty;}Patient->Appointment[dir=none,taillabel="1",headlabel="0..*"];Doctor->Appointment[dir=none,taillabel="1",headlabel="0..*"];Doctor->Slot[dir=both,arrowtail=diamond,arrowhead=none,taillabel="1",headlabel="0..*"];Specialty->Doctor[dir=none,taillabel="1",headlabel="0..*"];Slot->Appointment[dir=none,taillabel="1",headlabel="0..*",label="история"];Appointment->Notification[dir=both,arrowtail=diamond,arrowhead=none,taillabel="1",headlabel="0..*"];Administrator->Appointment[style=dashed,label="управляет"]; }